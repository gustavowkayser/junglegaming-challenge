NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_WAIT_TIME_SECONDS=10
HTTP_ENABLED=true
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
PENDING_REFERENCE_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=300000
SHUTDOWN_TIMEOUT_MS=20000
FAULT_INJECTION=none
