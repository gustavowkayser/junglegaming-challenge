{
    "name": "distributed-wagering-processor",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.11",
    "scripts": {
        "start": "bun src/main.ts",
        "start:dev": "bun --watch src/main.ts",
        "typecheck": "tsc --noEmit",
        "check": "biome check .",
        "format": "biome format --write .",
        "lint:fix": "biome check --write .",
        "test": "bun test test/unit",
        "test:unit": "bun test test/unit",
        "test:integration": "bun test test/integration",
        "test:concurrency": "bun test test/concurrency",
        "test:all": "bun test",
        "test:load": "bun test/load/load.script.ts",
        "db:migrate": "bun src/infrastructure/persistence/migrate.script.ts up",
        "db:rollback": "bun src/infrastructure/persistence/migrate.script.ts down",
        "queues:setup": "bun scripts/setup-queues.script.ts"
    },
    "dependencies": {
        "@aws-sdk/client-sqs": "^3.1172.0",
        "@mikro-orm/core": "^7.2.10",
        "@mikro-orm/migrations": "^7.2.10",
        "@mikro-orm/postgresql": "^7.2.10",
        "@nestjs/common": "^12.5.1",
        "@nestjs/config": "^12.1.1",
        "@nestjs/core": "^12.5.1",
        "@nestjs/platform-express": "^12.5.1",
        "@nestjs/terminus": "^12.2.0",
        "pino": "^10.4.0",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@types/bun": "^1.4.4",
        "@types/express": "^5.0.6",
        "typescript": "^7.0.2"
    }
}
